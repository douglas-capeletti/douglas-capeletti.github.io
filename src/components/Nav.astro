---
import { defaultLang, useTranslations, type Lang } from "../i18n/translations";
import { SITE_PAGES, SITE_URI } from "../utils/constants";
import LangToggle from "./LangToggle.astro";
import SearchButton from "./SearchButton.astro";
import SideNav from "./SideNav.astro";
import SideNavToggle from "./SideNavToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const strings = useTranslations(lang);
---

<div>
  <nav>
    <div class="max-w-5xl mx-auto px-3 py-3 flex items-center justify-between h-16">
      <div class="flex gap-2">
        <img style="max-height: 1.75rem" loading="lazy" src={"/images/logo.webp"} alt={"Logo"} />
        <a href="/" class="font-bold text-xl hover:text-contrast">{SITE_URI}</a>
      </div>
      <div class="hidden md:flex font-semibold -ml-6 gap-3">
        {
          SITE_PAGES.map((value) => (
            <a href={`/${lang}/${value.path}`} class="text-text-primary font-semibold hover:text-contrast">
              {strings(value.name)}
            </a>
          ))
        }
        <SearchButton classList="h6 w-6 hover:text-contrast" />
        <div class="ml-4 flex items-center gap-2">
          <ThemeToggle prefix="Nav" classList="h6 w-6 hover:text-contrast" />
          <LangToggle prefix="Nav" classList="h6 w-6 hover:text-contrast" />
        </div>
      </div>
      <SideNavToggle state={false} />
    </div>
  </nav>
  <div class="w-full border-b-2 border-border"></div>
  <SideNav />
</div>

<script>
  import { LANG, THEME } from "../utils/constants";
  import { toggle } from "../utils/toggle";
  toggle("Nav", LANG);
  toggle("Nav", THEME);
</script>
