---
import type { IPost } from "../utils/types";
import PostHeader from "./PostHeader.astro";

export interface Props extends IPost {
  printSuggestion?: boolean;
}
const { title, description, pubDate, hero, tags, video, printSuggestion } = Astro.props;
---

<article>
  <PostHeader title={title} description={description} pubDate={pubDate} tags={tags} />
  {hero && <img class="rounded-xl mx-auto py-3 lg:py-6" style="min-width: 80%; max-height: 30em" loading="lazy" src={hero} alt={title} />}
  {
    video && (
      <div class="embed-responsive aspect-ratio-16/9 mt-6 lg:mt-12">
        <iframe width="700" height="500" class="embed-responsive-item" src={`https://www.youtube.com/embed/${video}`} allow="accelerometer; autoplay; encrypted-media; gyroscope;" allowfullscreen />
      </div>
    )
  }
  <section class="py-3 lg:py-6 post">
    <slot />
  </section>
</article>

{
  printSuggestion && (
    <button
      onclick="window.print()"
      class="fixed bottom-6 right-6 z-50 p-3 md:p-4 lg:p-5 rounded-full shadow-xl bg-contrast text-bg-primary hover:opacity-90 transition-all duration-200 cursor-pointer hover:-translate-y-1"
      aria-label="Salvar em PDF"
      title="Salvar artigo em PDF"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 md:w-7 md:h-7 lg:w-8 lg:h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
        <path d="M5 12v-7a2 2 0 0 1 2-2h7l5 5v4"></path>
        <path d="M5 18h1.5a1.5 1.5 0 0 0 0-3h-1.5v6"></path>
        <path d="M17 18h2"></path>
        <path d="M20 15h-3v6"></path>
        <path d="M11 15v6h1a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-1z"></path>
      </svg>
    </button>
  )
}

<style is:global>
  @media print {
    body * {
      visibility: hidden;
    }

    article,
    article * {
      visibility: visible;
      opacity: 1 !important;
      color: black !important;
    }

    article {
      position: absolute;
      left: 0;
      top: 0;
      width: 100% !important;
    }

    body,
    html {
      background-color: white !important;
      color: black !important;
      color-scheme: light !important;
    }

    pre,
    blockquote,
    img,
    table,
    figure {
      page-break-inside: avoid;
    }
  }
</style>
