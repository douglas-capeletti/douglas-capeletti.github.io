---
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import { defaultLang, type Lang } from "../i18n/translations";
import { SITE_NAME, SITE_URI, THEME } from "../utils/constants";

export interface Props {
  title: string;
}

const { title } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const seoTitle = `${title ?? SITE_NAME} | ${SITE_URI}`;
---

<html lang={lang} class={THEME.id}>
  <Head title={seoTitle} />
  <body class="bg-bg-primary text-text-primary font-body leading-normal">
    <Nav />
    <main class="max-w-5xl px-5 mx-auto py-4 lg:py-8">
      <slot />
    </main>
  </body>
</html>
