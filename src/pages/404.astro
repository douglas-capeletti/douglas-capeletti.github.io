---
import BackToPage from "../components/BackToPage.astro";
import Header from "../components/Header.astro";
import { defaultLang, useTranslations, type Lang } from "../i18n/translations";
import PageLayout from "../layouts/PageLayout.astro";
import { siteLangParams } from "../utils/constants";

export function getStaticPaths() {
  return siteLangParams();
}

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const strings = useTranslations(lang);
---

<PageLayout title={strings("pages.not-found")}>
  <Header title={strings("not-found.title")} subTitles={[strings("not-found.sub-title")]} />
  <BackToPage />
  <img class="mx-auto max-w-xs md:max-w-2xl" alt="Mad Cat" src="/images/404.webp" />
</PageLayout>
