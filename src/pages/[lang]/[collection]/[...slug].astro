---
import { render } from "astro:content";
import BackToPage from "../../../components/BackToPage.astro";
import { type TranslationKey } from "../../../i18n/translations";
import PostLayout from "../../../layouts/PostLayout.astro";
import { getLocalizedCollection } from "../../../utils";
import { Collections, CollectionsEnum } from "../../../utils/constants";

export async function getStaticPaths() {
  const collections = [Collections[CollectionsEnum.NOTES], Collections[CollectionsEnum.GUIDES], Collections[CollectionsEnum.ABOUT]];
  return await getLocalizedCollection(collections, (collection, lang, posts) =>
    posts.map((post) => ({
      params: {
        lang,
        collection: collection.name,
        slug: post.id,
      },
      props: {
        post,
        path: `/${lang}/${collection.name}`,
        pageName: `pages.${collection.name}`,
        config: collection.config,
      },
    })), 
  );
}

const { post, path, pageName, config } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} config={config}>
  <Content />
</PostLayout>
<BackToPage pageName={pageName as TranslationKey} path={path} />
