---
import { defaultLang, useTranslations, type Lang, type TranslationKey } from "../../../i18n/translations";
import CardLayout from "../../../layouts/CardLayout.astro";
import { getLocalizedCollection } from "../../../utils";
import { Collections, CollectionsEnum } from "../../../utils/constants";
import type { ICard } from "../../../utils/types";

export async function getStaticPaths() {
  const collections = [Collections[CollectionsEnum.NOTES], Collections[CollectionsEnum.GUIDES], Collections[CollectionsEnum.ABOUT]];
  return await getLocalizedCollection(collections, (collection, lang, posts) => [
    {
      params: {
        lang,
        collection: collection.name,
      },
      props: {
        posts,
        pageName: `pages.${collection.name}`,
        pageDescription: `${collection.name}.title`,
        config: collection.config,
      },
    },
  ]);
}

const { collection } = Astro.params;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const strings = useTranslations(lang);

const { posts, pageName, pageDescription, config } = Astro.props;

const cards: ICard[] = posts?.map((p: any) => {
  return {
    tag: p.data.tags?.includes("draft") ? strings("ui.draft") : undefined,
    hero: p.data.hero,
    title: p.data.title,
    description: p.data.description,
    pubDate: p.data.pubDate,
    url: `/${lang}/${collection}/${p.id}`,
  };
});
---

<CardLayout title={strings(pageName as TranslationKey)} subTitles={[strings(pageDescription as TranslationKey)]} cards={cards} wideCards={config?.wideCards} />
