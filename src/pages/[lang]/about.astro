---
import { defaultLang, useTranslations, type Lang } from "../../i18n/translations";
import CardLayout from "../../layouts/CardLayout.astro";
import { SITE_LANGUAGE_PARAMS } from "../../utils/constants";

export function getStaticPaths() {
  return SITE_LANGUAGE_PARAMS;
}
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const strings = useTranslations(lang);
---

<CardLayout
  title={strings('pages.about')}
  cards={[
    {
      title: "Douglas Capeletti",
      url: "https://www.linkedin.com/in/douglas-capeletti/",
      blank: true,
    },
  ]}
  wideCards
/>
