---
import Header from "../../components/Header.astro";
import { defaultLang, type Lang, useTranslations } from "../../i18n/translations";
import PageLayout from "../../layouts/PageLayout.astro";
import { siteLangParams, SITE_NAME, SITE_PAGES } from "../../utils/constants";

export function getStaticPaths() {
  return siteLangParams();
}
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const strings = useTranslations(lang);
const description = strings("home.title");
---

<PageLayout title={description} className="py-2 md:py-20">
  <Header title={SITE_NAME} subTitles={[description]} />
  <section class="flex sm:flex-row flex-col gap-5 justify-center justify-items-center items-center" data-test="articles-section">
    {
      SITE_PAGES.map((value) => (
        <a href={`/${lang}/${value.path}`}>
          <button class="font-bold p-3 text-bg-primary bg-btn-primary rounded-xl">{strings(value.title)}</button>
        </a>
      ))
    }
  </section>
</PageLayout>
