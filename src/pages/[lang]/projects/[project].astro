---
import { getCollection, render } from "astro:content";
import BackToPage from "../../../components/BackToPage.astro";
import CardList from "../../../components/CardList.astro";
import PostLayout from "../../../layouts/PostLayout.astro";
import { LANGS, SITE_PROJECTS } from "../../../utils/constants";

export async function getStaticPaths() {
    return LANGS.flatMap((lang) =>
        SITE_PROJECTS.map((project) => ({
            params: {
                lang,
                project: project.path,
            },
        })),
    );
}

const { lang, project } = Astro.params;
const projectEntries = await getCollection(`${project}_${lang}` as any);
const entriesByType: any = {};
projectEntries.forEach((v: any) => {
    const type = v.id.split("/")?.[0] ?? "none";
    if (!entriesByType[type]) entriesByType[type] = [];
    entriesByType[type].push(v);
});

const indexEntry = entriesByType["index"]?.[0] || entriesByType[project]?.[0] || projectEntries[0];
const { Content } = await render(indexEntry);

const specs = entriesByType["specs"] || [];
const tools = entriesByType["tools"] || [];
---

<PostLayout post={indexEntry}>
    <Content />
    {
        specs.length > 0 && (
            <>
                <h2>Project Specs</h2>
                <CardList
                    cards={specs.map((x: any) => {
                        return {
                            title: x.data.title,
                            url: `/${lang}/projects/${project}/${x.id}`,
                        };
                    })}
                />
            </>
        )
    }
    {
        tools.length > 0 && (
            <>
                <h2>Project Tools</h2>
                <CardList
                    cards={tools.map((x: any) => {
                        return {
                            title: x.data.title,
                            url: `/${lang}/projects/${project}/${x.id}`,
                        };
                    })}
                />
            </>
        )
    }
</PostLayout>
<BackToPage pageName={"pages.projects"} path={`/${lang}/projects`} />
