---
import CardLayout from "../../../layouts/CardLayout.astro";
import { defaultLang, useTranslations, type Lang } from "../../../i18n/translations";

export async function getStaticPaths() {
  const langs: Lang[] = ["pt", "en"];
  return langs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const strings = useTranslations((lang as Lang) ?? defaultLang);

// 💡 Add more project collections here in the future! (e.g. ["voting", "portfolio"])
const activeProjects = ["voting"];
---

<CardLayout
  title={strings("pages.projects") as string}
  cards={activeProjects.map((project) => ({
    title: project.charAt(0).toUpperCase() + project.slice(1),
    url: `/${lang}/projects/${project}`
  }))}
  wideCards
/>
