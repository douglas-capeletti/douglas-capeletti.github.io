---
import { defaultLang, useTranslations, type Lang } from "../../../i18n/translations";
import CardLayout from "../../../layouts/CardLayout.astro";
import { SITE_PROJECTS, siteLangParams } from "../../../utils/constants";

export async function getStaticPaths() {
  return siteLangParams();
}

const { lang } = Astro.params;
const strings = useTranslations((lang as Lang) ?? defaultLang);
const cards = SITE_PROJECTS.map((project) => ({
  title: strings(project.title) as string,
  url: `/${lang}/projects/${project.path}`,
}));
---

<CardLayout title={strings("pages.projects") as string} subTitles={[strings("projects.title") as string]} cards={cards} wideCards />
