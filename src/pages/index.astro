<script>
    const supportedLangs = ["pt", "en"];
    let lang = localStorage.getItem("lang");
    
    if (!lang) {
        const browserLang = navigator.language.split('-')[0] ?? "pt";
        lang = supportedLangs.includes(browserLang) ? browserLang : "pt";
    }

    console.log(`Redirecting to /${lang}/`);
    window.location.replace(`/${lang}/`);
</script>
